<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>BazaarBoardReader</AssemblyName>
    <RootNamespace>BazaarBoardReader</RootNamespace>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <PropertyGroup>
    <BepInExRoot>G:\SteamLibrary\steamapps\common\The Bazaar\BepInEx</BepInExRoot>
    <GameManagedDir>G:\SteamLibrary\steamapps\common\The Bazaar\TheBazaar_Data\Managed</GameManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExRoot)\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExRoot)\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GameManagedDir)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(GameManagedDir)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BazaarGameClient">
      <HintPath>$(GameManagedDir)\BazaarGameClient.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BazaarGameShared">
      <HintPath>$(GameManagedDir)\BazaarGameShared.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BazaarBattleService">
      <HintPath>$(GameManagedDir)\BazaarBattleService.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BazaarUnityTools">
      <HintPath>$(GameManagedDir)\BazaarUnityTools.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TheBazaarRuntime">
      <HintPath>$(GameManagedDir)\TheBazaarRuntime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GameManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="temp_data\**" />
    <None Remove="temp_data\**" />
  </ItemGroup>
</Project>
